// Heat-map composition: extract points -> script-filter -> render heat map.
//
// Demonstrates the composable-facet pattern: a heat map of ANY tagged feature in
// ANY region is the same facets, only the params change.
//
// PREFER THE FAN-OUT. For anything bigger than a single state/province — a
// continent ("North America", "Europe") or a large country ("United States",
// "Germany") — use ContinentHeatmap, NOT AmenityHeatmap. Downloading and
// extracting a whole-continent / large-country PBF needs a big host (the
// continent PBF is ~14GB and OOMs osmium on a modest box) and is serial.
// ContinentHeatmap instead fans a `foreach` over the region's Geofabrik leaves
// (states/provinces) — each leaf PBF is small, extracts on a modest host, and
// the N leaves run in parallel across the runner fleet, then merge into one map.
// AmenityHeatmap is the single-leaf / single-small-region path only.
//
// Prerequisites: compile with osmtypes.ffl, osmregion.ffl, osmcache_download.ffl,
//   osm_source_pbf.ffl, osmfilters.ffl, osmtransform.ffl, osmvisualization.ffl.

/** Heat maps over OSM features via extract -> script-filter -> render. */
namespace osm.heatmap {
    use osm.types
    use osm.Region
    use osm.cache
    use osm.Source.PBF
    use osm.Filters
    use osm.Transform
    use osm.viz

    /** Single-region heat map (one Geofabrik leaf / one small region). For a
     *  CONTINENT or LARGE COUNTRY use ContinentHeatmap instead — it fans out over
     *  the subregions and avoids the big-host whole-PBF download/extract this path
     *  would otherwise need. Default = Tesla superchargers in California.
     *
     *  Pipeline: Download the region PBF (cache hit if present) -> extract the
     *  point category -> ByScript-filter to the features of interest (the
     *  default script keeps charging stations whose operator/brand mentions
     *  Tesla, or that carry a `socket:tesla*` tag) -> RenderHeatmap.
     *
     *  Reusable: `category="food", filter_script="props.get('cuisine')=='pizza'"`,
     *  `style="grid"`, a different (small) region — same facets (category must be
     *  a valid CombinedScan category: amenities, food, fuel_charging, parks,
     *  water, …). */
    workflow AmenityHeatmap(
        region: String = "California",
        category: String = "amenities",
        filter_script: String = "props.get('amenity') == 'charging_station' and ('tesla' in str(props.get('operator','')).lower() or 'tesla' in str(props.get('brand','')).lower() or 'tesla' in str(props.get('network','')).lower() or any(k.startswith('socket:tesla') for k in props))",
        style: String = "kernel",
        title: String = "Tesla Superchargers — California",
        cache_policy: String = "prefer_cache"
    ) => (map_html: String, match_count: Long) andThen {
        resolved = osm.Region.ResolveRegion(name = $.region)
        cache = osm.cache.Download(region = resolved.region, cache_policy = $.cache_policy)
        pts   = osm.Source.PBF.ExtractCategory(cache = cache.cache, category = $.category)
        sub   = osm.Filters.ByScript(input_path = pts.output_path, script = $.filter_script)
        heat  = osm.viz.RenderHeatmap(points = sub.output_path, style = $.style, title = $.title)
        yield AmenityHeatmap(map_html = heat.html_path, match_count = sub.feature_count)
    }

    /** Inner fan-out: expand `region_names` to their finest-grained Geofabrik
     *  leaves (e.g. "North America" → US states + Canadian provinces + Mexico +
     *  Greenland) and, IN PARALLEL across the runner fleet, extract + script-filter
     *  each leaf. Each leaf PBF is small enough to extract on a modest host, so a
     *  continent that the whole-continent path can't handle becomes N independent,
     *  parallel sub-jobs. The list-typed `filtered_paths` yield aggregates every
     *  leaf's filtered GeoJSON into one list at completion. */
    workflow SubregionChargers(
        region_names: [String] = ["North America"],
        category: String = "amenities",
        filter_script: String = "props.get('amenity') == 'charging_station' and ('tesla' in str(props.get('operator','')).lower() or 'tesla' in str(props.get('brand','')).lower() or 'tesla' in str(props.get('network','')).lower() or any(k.startswith('socket:tesla') for k in props))",
        cache_policy: String = "prefer_cache"
    ) => (filtered_paths: [String]) andThen {
        // The per-leaf fan-out is `resolved`'s STEP BODY, so `resolved.regions`
        // names its containing step (in scope) rather than a sibling block —
        // required by REF_CROSS_BLOCK_STEP. Same fan-out, legal scoping.
        resolved = osm.Region.ResolveRegions(names = $.region_names, expand = "subregions") andThen foreach r in $.regions {
            dl   = osm.cache.Download(region = $.r, cache_policy = $$.cache_policy)
            pts  = osm.Source.PBF.ExtractCategory(cache = dl.cache, category = $$.category)
            filt = osm.Filters.ByScript(input_path = pts.output_path, script = $$.filter_script)
            yield SubregionChargers(filtered_paths = [filt.output_path])
        }
    }

    /** PREFERRED entry point for any continent or large country. Continent-scale
     *  heat map without a bigger host: fan out per state/province (SubregionChargers),
     *  merge the small per-leaf filtered point sets into one GeoJSON (MergeLayers),
     *  and render a single heat map. Each leaf PBF extracts on a modest host and the
     *  N leaves run in parallel across the runner fleet (the whole-continent PBF
     *  would need a big box and run serially) — add runners to go faster. Default =
     *  Tesla superchargers across all of North America (64 leaves). Reusable for any
     *  "heatmap of X across <continent/country>": region_names=["Europe"], a
     *  different category/filter_script, style="grid". */
    workflow ContinentHeatmap(
        region_names: [String] = ["North America"],
        category: String = "amenities",
        filter_script: String = "props.get('amenity') == 'charging_station' and ('tesla' in str(props.get('operator','')).lower() or 'tesla' in str(props.get('brand','')).lower() or 'tesla' in str(props.get('network','')).lower() or any(k.startswith('socket:tesla') for k in props))",
        style: String = "kernel",
        title: String = "Tesla Superchargers — North America",
        cache_policy: String = "prefer_cache"
    ) => (map_html: String, match_count: Long) andThen {
        ext    = osm.heatmap.SubregionChargers(
                   region_names = $.region_names, category = $.category,
                   filter_script = $.filter_script, cache_policy = $.cache_policy)
        merged = osm.Transform.MergeLayers(inputs = ext.filtered_paths)
        heat   = osm.viz.RenderHeatmap(points = merged.result.output_path, style = $.style, title = $.title)
        yield ContinentHeatmap(map_html = heat.html_path, match_count = heat.point_count)
    }
}
