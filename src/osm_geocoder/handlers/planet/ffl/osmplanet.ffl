// Self-hosted OSM extracts pipeline — build (and keep current) our own
// "Geofabrik": download the planet, delta-update it from replication, download
// osmfr boundary polygons, extract per-region PBFs, and publish them to the
// object store (s3://osm-extracts) that the fleet's FW_GEOFABRIK_BASE_URL reads.
//
// Backed by the standalone tools download-planet / download-polygons /
// planet-bootstrap (tools/_osm_tools/{planet_fetch,polygon_fetch,planet_bootstrap}).

namespace osm.planet {

    /** A boundary region: a Geofabrik-style key + the osmfr .poly that defines it. */
    schema Region {
        key: String,
        poly: String
    }

    /** Download planet-latest.osm.pbf (resumable, md5-verified) to `dest`
        (empty = the host's FW_PLANET_DIR default). The master the extracts are
        derived from; sourced from planet.openstreetmap.org (Geofabrik is banned). */
    event facet DownloadPlanet(dest: String = "", verify: Boolean = true) => (planet_path: String, size_mb: Double, was_cached: Boolean) with Effect(kind = "external") with Cost(tier = "expensive")

    /** Bring the planet current by applying replication diffs (timestamp-driven,
        since the planet dump carries no replication sequence). Degrades to a
        no-op status when replication is unreachable rather than failing. */
    event facet UpdatePlanet(planet_path: String, max_diff_mb: Long = 4096) => (planet_path: String, status: String, advanced: Boolean) with Effect(kind = "external") with Cost(tier = "expensive")

    /** Download boundary polygons. `scope`: "continents", "countries" (~199), or
        "all" (osmfr); or "subnational" — US states from Census TIGER (osmfr has no
        per-state polys, Geofabrik is banned), as GeoJSON. Keys are normalised to
        Geofabrik style (north-america/us/<state>) so region requests resolve. */
    event facet DownloadPolygons(dest: String = "", scope: String = "all") => (poly_dir: String, region_count: Long, regions: [Region]) with Effect(kind = "external") with Cost(tier = "moderate")

    /** Generate region polygons FROM OSM admin boundaries — no external source.
        Filters `boundary=administrative` relations at `admin_level` out of `source`
        (the planet, or a continent/country extract for a cheaper pass) and
        assembles them via osmium export. Self-contained + universal (any level,
        worldwide); relations that fail assembly are skipped. `admin_level`:
        2=country, 4=state/province, 6=county. Returns the same [Region] shape as
        DownloadPolygons, so ExtractRegions consumes it interchangeably. */
    event facet GenerateRegionPolygons(source: String = "", admin_level: Long = 2, dest: String = "") => (poly_dir: String, region_count: Long, regions: [Region]) with Effect(kind = "io") with Cost(tier = "expensive")

    /** Split the planet into per-region PBFs — one osmium pass per `batch_size`
        regions to bound RAM (osmium holds a node-id set per region). Writes the
        `<key>-latest.osm.pbf` + `<key>-updates/state.txt` tree under `out`.

        `Requires(memory_gb = 10)` matches BuildAdminSet: same osmium work, same
        `complete_ways` strategy, at PLANET scale over more regions, so it cannot
        need less. Measured 2026-08-26/29 — BuildAdminSet peaked at 7.7 GB against
        server3's 10.2 GB budget, and OOM'd on MaxPro's 7.75 GiB at Laender scale.
        Without the floor MaxPro claims a job it cannot finish and only discovers
        that after the planet download, which is hours of wasted work before the
        retry lands where it should have started. */
    event facet ExtractRegions(
        planet_path: String = "",
        regions: [Region],
        out: String = "",
        base_url: String = "",
        strategy: String = "complete_ways",
        batch_size: Long = 25,
        source_region: String = "",
        bucket: String = "osm-extracts",
        force_rebuild: Boolean = false
    ) => (region_count: Long, out: String) with Effect(kind = "io") with Cost(tier = "expensive") with Requires(memory_gb = 10)

    /** Upload the extracted tree from `out` to the S3/MinIO `bucket`
        (anonymous-read), so FW_GEOFABRIK_BASE_URL consumers can fetch them. */
    event facet PublishExtracts(out: String = "", bucket: String = "osm-extracts", regions: [Region] = []) => (bucket: String, published: Long) with Effect(kind = "io") with Cost(tier = "expensive")

    /** End-to-end: download planet -> delta-update -> download all polygons ->
        extract per-region PBFs -> publish. Run on a schedule to keep the
        self-hosted "Geofabrik" fresh. */
    workflow BuildPlanetExtracts(
        dest: String = "",
        polys_dest: String = "",
        scope: String = "all",
        out: String = "",
        base_url: String = "",
        strategy: String = "complete_ways",
        batch_size: Long = 25,
        bucket: String = "osm-extracts",
        source_region: String = ""
    ) => (region_count: Long, published: Long) andThen {
        planet = osm.planet.DownloadPlanet(dest = $.dest)
        updated = osm.planet.UpdatePlanet(planet_path = planet.planet_path)
        polys = osm.planet.DownloadPolygons(dest = $.polys_dest, scope = $.scope)
        extract = osm.planet.ExtractRegions(
            planet_path = updated.planet_path,
            regions = polys.regions,
            out = $.out,
            base_url = $.base_url,
            strategy = $.strategy,
            batch_size = $.batch_size,
            source_region = $.source_region
        )
        pub = osm.planet.PublishExtracts(out = extract.out, bucket = $.bucket, regions = polys.regions)
        yield BuildPlanetExtracts(region_count = extract.region_count, published = pub.published)
    }

    /** Build extracts for one admin level from OSM admin boundaries (self-generated
        polygons — no external source): generate the boundaries at `admin_level`
        from `source`, extract each region, and publish. Scoped by the source —
        e.g. German Länder = source is a germany extract, admin_level=4. */
    workflow BuildAdminExtracts(
        source: String = "",
        admin_level: Long = 4,
        polys_dest: String = "",
        out: String = "",
        base_url: String = "",
        strategy: String = "complete_ways",
        bucket: String = "osm-extracts"
    ) => (region_count: Long, published: Long) andThen {
        polys = osm.planet.GenerateRegionPolygons(source = $.source, admin_level = $.admin_level, dest = $.polys_dest)
        extract = osm.planet.ExtractRegions(planet_path = $.source, regions = polys.regions, out = $.out, base_url = $.base_url, strategy = $.strategy)
        pub = osm.planet.PublishExtracts(out = extract.out, bucket = $.bucket)
        yield BuildAdminExtracts(region_count = extract.region_count, published = pub.published)
    }

    /** SINGLE-TASK admin set — the distributed-fleet-safe path. ONE handler
        downloads `source_region` from the bucket, generates its `admin_level`
        boundaries, extracts each, and publishes, ALL on the one host that claims
        it — so it runs cleanly across the multi-host fleet with no cross-host
        local-file handoff. Scoped by the source: source_region="europe/germany",
        admin_level=4 → German Länder; "north-america/canada", 4 → provinces.
        `batch_size` 0 = ADAPTIVE (default): the batcher detects the memory ceiling
        (cgroup / the Docker-VM's real RAM), keeps each osmium pass under a fraction
        of it, MEASURES the peak, learns a per-region cost, and self-heals on OOM —
        no more hand-guessing (a dense province ~1.5 GB of node-id bitmap alone, and
        batch=25 over a big country would need ~37 GB). Pass batch_size>0 to force a
        fixed count. `osmfr_fallback` (default true): fill sub-national stragglers
        osmium export can't assemble (nested sub-relations, member ways beyond the
        source poly — e.g. Quebec/Nova Scotia/Nunavut) from a region-aware ready-made
        poly source: TIGER for US states (osmfr has none), osmfr for everywhere else. */
    event facet BuildAdminSet(source_region: String, admin_level: Long = 4, base_url: String = "", strategy: String = "complete_ways", bucket: String = "osm-extracts", batch_size: Long = 0, osmfr_fallback: Boolean = true, refresh_after_days: Long = 0, force_refresh: Boolean = false) => (region_count: Long, published: Long, unreproducible: Long) with Effect(kind = "io") with Cost(tier = "expensive") with Requires(memory_gb = 10)

    /** Distributed fleet run of a self-generated admin set — one BuildAdminSet
        task, so it executes atomically on a single fleet host. */
    workflow BuildAdminSetWorkflow(source_region: String, admin_level: Long = 4, base_url: String = "", strategy: String = "complete_ways", bucket: String = "osm-extracts", batch_size: Long = 0, osmfr_fallback: Boolean = true, refresh_after_days: Long = 0, force_refresh: Boolean = false) => (region_count: Long, published: Long, unreproducible: Long) andThen {
        result = osm.planet.BuildAdminSet(source_region = $.source_region, admin_level = $.admin_level, base_url = $.base_url, strategy = $.strategy, bucket = $.bucket, batch_size = $.batch_size, osmfr_fallback = $.osmfr_fallback, refresh_after_days = $.refresh_after_days, force_refresh = $.force_refresh)
        yield BuildAdminSetWorkflow(region_count = result.region_count, published = result.published)
    }

    /** List the DIRECT-CHILD extract keys under `prefix` (e.g. the 51 US states under
        "north-america/us") — the fan-out driver: a workflow foreach's over these. */
    event facet ListExtracts(prefix: String, bucket: String = "osm-extracts") => (regions: [String], count: Long) with Effect(kind = "io") with Cost(tier = "free")

    /** FAN-OUT: build one admin level BELOW each direct child of `prefix`, one
        BuildAdminSet task per child, distributed across the fleet. US counties =
        prefix "north-america/us", admin_level 6: fan a per-STATE BuildAdminSet over
        the 51 states (each self-generates its counties from that state's extract and
        keys them north-america/us/<state>/<county> — nested, so the ~30 states with
        a "Washington County" don't collide). The N states run in PARALLEL across the
        runner fleet, so wall-clock ≈ the slowest single state, not the sum. Add
        runners to go faster. `strategy` "simple" suits many small interior regions. 

        WARNING: `unreproducible` aggregates regions published under a child
        prefix that this admin_level CANNOT regenerate - OSM has no boundary
        relation for them, or one lacking the required ISO code. Measured
        2026-08-31 across the 51 US states: 645 of 3167 counties, about a
        fifth. They can never be refreshed by this path, so without this the
        fan-out reports success while that share of the tier ages forever.
        Aggregated so the total is ONE number, not 51 log lines nobody sums.
        */
    workflow BuildAdminFanout(prefix: String = "north-america/us", admin_level: Long = 6, strategy: String = "simple", base_url: String = "", bucket: String = "osm-extracts", osmfr_fallback: Boolean = true, refresh_after_days: Long = 0, force_refresh: Boolean = false, width: Int = 0) => (published: [Long], unreproducible: [Long]) andThen {
        children = osm.planet.ListExtracts(prefix = $.prefix, bucket = $.bucket) andThen foreach child in $.regions limit $$.width {
            leaf = osm.planet.BuildAdminSet(source_region = $.child, admin_level = $$.admin_level, strategy = $$.strategy, base_url = $$.base_url, bucket = $$.bucket, osmfr_fallback = $$.osmfr_fallback, refresh_after_days = $$.refresh_after_days, force_refresh = $$.force_refresh)
            yield BuildAdminFanout(published += [leaf.published], unreproducible += [leaf.unreproducible])
        }
    }


    /** Assert that every `patterns` artifact in the bucket is younger than
        `max_age_days`, and FAIL the step otherwise.

        This is the guard that used to live only in `_osm_admin_scope.py`, i.e.
        outside the runtime — so it protected the `fw svc osm-admin-regen` path
        and nothing else. Any other caller (a dashboard run, a direct submit, a
        composed workflow like RefreshChain below) cut from whatever the bucket
        happened to hold. Expressing it as a facet puts the chain's correctness
        property inside the chain. */
    event facet RequireFresh(
        patterns: [String],
        bucket: String = "osm-extracts",
        max_age_days: Long = 14
    ) => (checked: Long, stale: Long, oldest_days: Double)
        with Effect(kind = "io") with Cost(tier = "free")

    /** THE top-level entry point: planet -> continents -> countries -> US states,
        in one submission, with the ordering and placement rules the chain has
        always had but that a human had to enforce by hand.

        Three things are expressed here rather than in an operator's head:

        1. ORDER. Each tier is cut from the tier above, read out of the OBJECT
           STORE - so no value flows between them and the compiler cannot see the
           edge. `after` is exactly that: the invisible dependency. Building a
           tier from a stale parent stamps children with a fresh write time over
           month-old data, and sub-regions carry no replication timestamp, so
           nothing downstream could ever detect it.

        2. PLACEMENT. The planet steps carry `Requires(dataset_planet_gb = 80)`.
           The 92 GB master exists on ONE host, while every osm runner in the
           fleet advertises its handler - so without this any of them could claim
           the work and then try to fetch 92 GB. Runners advertise a dataset
           dimension only when they can actually stat the file (see
           base_runner.measured_resources), and an unadvertised dimension makes a
           runner DECLINE, so this routes to the planet host without naming it.

        3. FRESHNESS. RequireFresh gates the country tier on the continents this
           same run just published, so a partial upstream failure stops the chain
           instead of silently propagating.

        Left deliberately OUT: the 3,167-way county tier. It is a separate
        submission (BuildAdminFanout) because it has frozen before and wants its
        own `foreach limit`. */
    workflow RefreshChain(
        bucket: String = "osm-extracts",
        strategy: String = "complete_ways",
        batch_size: Long = 2,
        country_regions: [String] = ["europe", "africa", "asia", "australia-oceania", "south-america", "central-america"],
        country_width: Int = 2,
        max_age_days: Long = 14,
        osmfr_fallback: Boolean = false,
        refresh_after_days: Long = 0,
        force_refresh: Boolean = false
    ) => (continents: Long, countries: [Long]) andThen {

        planet = osm.planet.DownloadPlanet() with Requires(dataset_planet_gb = 80)
        updated = osm.planet.UpdatePlanet(planet_path = planet.planet_path) with Requires(dataset_planet_gb = 80)
        polys = osm.planet.DownloadPolygons(scope = "continents")
        extract = osm.planet.ExtractRegions(
            planet_path = updated.planet_path,
            regions = polys.regions,
            strategy = $.strategy,
            batch_size = $.batch_size
        ) with Requires(dataset_planet_gb = 80)
        pub = osm.planet.PublishExtracts(out = extract.out, bucket = $.bucket)

        gate = osm.planet.RequireFresh(
            patterns = $.country_regions,
            bucket = $.bucket,
            max_age_days = $.max_age_days
        ) andThen foreach c in $$.country_regions limit $$.country_width {
            set = osm.planet.BuildAdminSet(
                source_region = $.c,
                admin_level = 2,
                strategy = $$.strategy,
                bucket = $$.bucket,
                osmfr_fallback = $$.osmfr_fallback,
                refresh_after_days = $$.refresh_after_days,
                force_refresh = $$.force_refresh
            )
            yield RefreshChain(countries += [set.published])
        }

        yield RefreshChain(continents = pub.published)
    }


    /** Cut a tier from a CONTINENT held in the object store — the planet is never
        touched, so this runs ANYWHERE with enough scratch.

        This is `BuildPlanetExtracts` minus its first two steps. Those two —
        DownloadPlanet and UpdatePlanet — are the only reason the US state tier
        was pinned to the one host holding the 92 GB master, even though its
        actual source is the 20 GB north-america extract and its own notes say so
        ("~4.4x less I/O AND proportionally less RAM per region"). The planet was
        downloaded and updated first purely because the workflow bundled it.

        Splitting it costs nothing in correctness: `source_region` already existed
        on ExtractRegions, the resolver now fetches that region from the bucket
        when it is not in the local tree, and every tier below the continents
        reads the object store anyway. It buys the state tier the whole fleet
        instead of one machine. */
    workflow BuildRegionExtracts(
        source_region: String = "north-america",
        scope: String = "subnational",
        polys_dest: String = "",
        out: String = "",
        base_url: String = "",
        strategy: String = "complete_ways",
        batch_size: Long = 4,
        bucket: String = "osm-extracts"
    ) => (region_count: Long, published: Long) andThen {
        polys = osm.planet.DownloadPolygons(dest = $.polys_dest, scope = $.scope)
        extract = osm.planet.ExtractRegions(
            regions = polys.regions,
            out = $.out,
            base_url = $.base_url,
            strategy = $.strategy,
            batch_size = $.batch_size,
            source_region = $.source_region,
            bucket = $.bucket
        )
        pub = osm.planet.PublishExtracts(out = extract.out, bucket = $.bucket)
        yield BuildRegionExtracts(region_count = extract.region_count, published = pub.published)
    }

}
