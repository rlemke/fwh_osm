// OSM change detection from Geofabrik replication diffs.
//
// Reuses the replication machinery added for osm.cache.UpdateRegion: instead of
// applying the day's `.osc.gz` diffs to the cached PBF, it SURFACES them — which
// features were added / modified / deleted since a point in time. "What new
// restaurants opened", "which buildings were removed", freshness monitoring.
//
// Scope: NODE / WAY / RELATION changes all carry geometry. Geometry is assembled
// by the osmium CLI's area builder (the same engine the static extractors use):
// the collected diff is applied onto the cached base extract, the changed
// way/relation ids (plus their members) are subset out, and exported — yielding
// Point (node) / LineString (open way) / Polygon (area way) / MultiPolygon
// (multipolygon & boundary relations, holes included). A closed way is correctly
// a LineString or Polygon per OSM area rules (not a naive ring guess). Geometry
// degrades to null (id kept) when the region isn't cached; deleted objects always
// carry null geometry.
//
// Prerequisites: compile with osmtypes.ffl, osmregion.ffl, osmcache_download.ffl.

namespace osm.Change {
    use osm.types

    /** Result of a change extraction: three GeoJSON paths (added/modified/
        deleted features — nodes as Points, ways as LineString/Polygon, relations
        as Polygon/MultiPolygon) + counts. `*_count` are total feature counts per
        bucket; `ways_*` / `relations_*` break out how many of those were ways /
        relations. */
    schema ChangeSet {
        region: Region,
        added: String,
        modified: String,
        deleted: String,
        added_count: Long,
        modified_count: Long,
        deleted_count: Long,
        ways_added: Long,
        ways_modified: Long,
        ways_deleted: Long,
        ways_changed: Long,
        relations_added: Long,
        relations_modified: Long,
        relations_deleted: Long,
        relations_changed: Long,
        since_sequence: Long
    }

    /** Extract the OSM features changed in `region` since `since`, from
        Geofabrik replication diffs.

        `since` is an ISO date ("2026-06-01"), a replication sequence number, or
        "" (= the cached extract's own replication timestamp → "what changed since
        my cache was last current"). `max_diff_mb` caps the diff data pulled.

        Emits node, way AND relation changes as GeoJSON (added = new, modified =
        edited, deleted = removed); nodes become Points, ways LineString/Polygon,
        relations Polygon/MultiPolygon (geometry null if the region isn't cached).
        Each feature carries tags + osm id + osm_type + change_type + version.
        Light on Geofabrik (diffs are KB–MB), like UpdateRegion; way/relation
        geometry is assembled locally from the cached extract. */
    event facet ExtractChanges(region: Region, since: String = "", max_diff_mb: Long = 512) => (changes: ChangeSet) with Effect(kind = "external") with Cost(tier = "moderate")
}
