// OSM change detection from Geofabrik replication diffs.
//
// Reuses the replication machinery added for osm.cache.UpdateRegion: instead of
// applying the day's `.osc.gz` diffs to the cached PBF, it SURFACES them — which
// features were added / modified / deleted since a point in time. "What new
// restaurants opened", "which buildings were removed", freshness monitoring.
//
// Scope: NODE changes (the POI case) carry Point geometry; WAY changes carry
// LineString (open way) / Polygon (closed/area way) geometry, with the way's
// node coordinates resolved from the diff's changed nodes plus a filtered scan
// of the base cached extract. RELATION changes are counted only — their
// geometry (member resolution) is a separate, bigger problem (a follow-up).
//
// Prerequisites: compile with osmtypes.ffl, osmregion.ffl, osmcache_download.ffl.

namespace osm.Change {
    use osm.types

    /** Result of a change extraction: three GeoJSON paths (added/modified/
        deleted features — nodes as Points, ways as LineString/Polygon) + counts.
        `*_count` are total feature counts per bucket; `ways_*` break out how many
        of those were ways. `relations_changed` is counted for awareness even
        though relation geometry is not emitted. */
    schema ChangeSet {
        region: Region,
        added: String,
        modified: String,
        deleted: String,
        added_count: Long,
        modified_count: Long,
        deleted_count: Long,
        ways_added: Long,
        ways_modified: Long,
        ways_deleted: Long,
        ways_changed: Long,
        relations_changed: Long,
        since_sequence: Long
    }

    /** Extract the OSM features changed in `region` since `since`, from
        Geofabrik replication diffs.

        `since` is an ISO date ("2026-06-01"), a replication sequence number, or
        "" (= the cached extract's own replication timestamp → "what changed since
        my cache was last current"). `max_diff_mb` caps the diff data pulled.

        Emits node AND way changes as GeoJSON (added = new, modified = edited,
        deleted = removed); nodes become Points, ways become LineString/Polygon
        (geometry null if a way's node coords can't be resolved). Each feature
        carries tags + osm id + osm_type + change_type + version. Light on
        Geofabrik (diffs are KB–MB), like UpdateRegion. */
    event facet ExtractChanges(region: Region, since: String = "", max_diff_mb: Long = 512) => (changes: ChangeSet) with Effect(kind = "external") with Cost(tier = "moderate")
}
