// Spatial relation facets — relate two GeoJSON layers by distance.
//
// The "universal verb" of the OSM toolchain: keep or annotate the features of a
// SUBJECT layer by their distance to a REFERENCE layer. The same operation
// appears as Overpass `around`, the routing engines' table/isochrone, turf's
// nearestPoint/pointsWithinPolygon, and PostGIS ST_DWithin / ST_Distance / KNN.
// It is what unlocks compound requests like "food deserts" (population points
// beyond 1 mi of any supermarket) or "schools without a pharmacy within 1 mi".
//
// Contract (uniform with the Extract/Filter layers):
//   subject GeoJSON path + reference GeoJSON path + distance -> GeoJSON path.
// Tags are preserved, so a spatial result feeds any downstream Filter/Render.
//
// Distances are computed in a local azimuthal-equidistant projection centered on
// the combined data centroid — accurate at the regional (state / metro) extents
// these primitives compose at. For continental inputs, Clip first (see the
// library roadmap), then relate.

/** Distance relations between two GeoJSON layers (within / beyond / nearest). */
namespace osm.Spatial {

    /** Result of a spatial-distance operation over two GeoJSON layers. */
    schema SpatialResult {
        output_path: String,
        feature_count: Long,
        original_count: Long,
        reference_count: Long,
        operation: String,
        distance: Double,
        unit: String,
        format: String,
        extraction_date: String
    }

    /** Keeps SUBJECT features within `distance` of ANY REFERENCE feature; each
        kept feature is annotated with `nearest_distance_m` / `nearest_distance`.
        The "Overpass around" / PostGIS ST_DWithin primitive — e.g. addresses
        within 1 km of a transit stop. */
    event facet WithinDistance(subject_path: String, reference_path: String,
        distance: Double, unit: String = "miles") => (result: SpatialResult) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Keeps SUBJECT features beyond `distance` from EVERY REFERENCE feature —
        the complement of WithinDistance. The "food desert" primitive: population
        points more than `distance` from any supermarket (or any hospital, school,
        pharmacy — whatever the reference layer holds). */
    event facet BeyondDistance(subject_path: String, reference_path: String,
        distance: Double, unit: String = "miles") => (result: SpatialResult) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Annotates every SUBJECT feature with the distance to its nearest REFERENCE
        feature (`nearest_distance_m` / `nearest_distance`, plus `nearest_ref_name`
        when the reference carries a `name`). Keeps all subject features — the
        PostGIS `<->` KNN / turf nearestPoint primitive. `distance`, when > 0,
        caps the search radius (features with no reference within it get a null
        annotation). */
    event facet Nearest(subject_path: String, reference_path: String,
        unit: String = "miles", distance: Double = 0.0) => (result: SpatialResult) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Attaches matching REFERENCE-layer properties onto each SUBJECT feature by
        a topological predicate (`intersects` | `within` | `contains`) — the
        point-in-polygon join (PostGIS ST_Within join / GeoPandas sjoin / turf).
        The first match's properties are copied under `prefix` (plus
        `<prefix>joined_count`). `how="inner"` keeps only matched subjects;
        `how="left"` keeps all. e.g. tag each business point with the census tract
        (`within`) it falls inside. */
    event facet SpatialJoin(subject_path: String, reference_path: String, predicate: String = "intersects", prefix: String = "ref_", how: String = "left") => (result: SpatialResult) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Buffers every feature by `distance` (in `unit`) into polygons — the area
        within `distance` of each feature (PostGIS ST_Buffer / turf buffer). Tags
        preserved; feed the result to SpatialJoin / WithinDistance or RenderMap
        (e.g. supermarket service-area coverage). Buffered in a local
        azimuthal-equidistant projection, reprojected to WGS84. */
    event facet Buffer(input_path: String, distance: Double, unit: String = "miles") => (result: SpatialResult) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Clips each SUBJECT feature to the CLIP layer's geometry (PostGIS
        ST_Intersection / turf intersect) — the clip layer is unioned into one
        mask, each subject geometry is intersected with it, and the overlapping
        part is kept (subject properties preserved); non-overlapping features are
        dropped. The geometric cookie-cutter, distinct from SpatialJoin (which
        attaches attributes without cutting geometry). e.g. parks within a city. */
    event facet Intersect(subject_path: String, clip_path: String) => (result: SpatialResult) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Unions all geometries into ONE merged feature (PostGIS ST_Union aggregate
        / turf union). With `other_path`, merges both layers; else the single
        layer's features. The whole-layer / two-layer merge, distinct from Dissolve
        (which unions per group). e.g. the combined footprint of many polygons. */
    event facet Union(input_path: String, other_path: String = "") => (result: SpatialResult) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Replaces each feature's geometry with its centroid Point (PostGIS
        ST_Centroid / turf centroid), preserving properties — reduce polygons/lines
        to label/anchor points (e.g. to feed the point-based Spatial verbs or
        RenderMap markers). 1:1 feature count. */
    event facet Centroid(input_path: String) => (result: SpatialResult) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Douglas-Peucker simplifies each geometry at `tolerance` (in `unit`, default
        meters), dropping vertices within tolerance of the simplified line (PostGIS
        ST_Simplify / turf simplify). Topology-preserving; computed in a local
        equidistant projection so the tolerance is metric. Properties preserved. */
    event facet Simplify(input_path: String, tolerance: Double, unit: String = "meters") => (result: SpatialResult) with Effect(kind = "pure") with Cost(tier = "cheap")
}
