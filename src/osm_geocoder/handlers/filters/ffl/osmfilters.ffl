// OSM filtering facets
//
// Radius-based filtering converts polygon boundaries to equivalent circular radius:
//   radius = sqrt(area / π)
//
// Type/tag filtering supports OSM element types (node, way, relation) and tags.
// Optional dependency inclusion provides complete geometries for ways/relations.

/** Spatial and tag-based filtering of OSM features by radius, type, and element tags. */
namespace osm.Filters {
    use osm.types

    /** Filtered GeoJSON output with feature counts and applied filter metadata. */
    schema FilteredFeatures {
        output_path: String,
        feature_count: Long,
        original_count: Long,
        boundary_type: String,
        filter_applied: String,
        format: String,
        extraction_date: String
    }

    /** Filtered OSM output including dependency resolution metadata. */
    schema OSMFilteredFeatures {
        output_path: String,
        feature_count: Long,
        original_count: Long,
        osm_type: String,
        filter_applied: String,
        dependencies_included: Boolean,
        dependency_count: Long,
        format: String,
        extraction_date: String
    }

    /** Filters GeoJSON features by equivalent circular radius with comparison operator. */
    event facet FilterByRadius(input_path: String, radius: Double,
        unit: String = "kilometers", operator: String = "gte") => (result: FilteredFeatures) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Filters GeoJSON features by inclusive radius range. */
    event facet FilterByRadiusRange(input_path: String, min_radius: Double,
        max_radius: Double, unit: String = "kilometers") => (result: FilteredFeatures) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Filters GeoJSON features by boundary type combined with radius threshold. */
    event facet FilterByTypeAndRadius(input_path: String, boundary_type: String,
        radius: Double, unit: String = "kilometers", operator: String = "gte") => (result: FilteredFeatures) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Extracts boundaries from PBF and filters by radius in a single operation. */
    event facet ExtractAndFilterByRadius(cache: OSMCache, admin_levels: [Long],
        natural_types: [String], radius: Double, unit: String = "kilometers",
        operator: String = "gte") => (result: FilteredFeatures) with Effect(kind = "external") with Cost(tier = "expensive")

    /** Filters PBF by OSM element type (node, way, relation) with optional dependency inclusion. */
    event facet FilterByOSMType(input_path: String, osm_type: String,
        include_dependencies: Boolean = false) => (result: OSMFilteredFeatures) with Effect(kind = "external") with Cost(tier = "expensive")

    /** Filters PBF by OSM tag key/value pair, optionally restricted to an element type. */
    event facet FilterByOSMTag(input_path: String, tag_key: String,
        tag_value: String = "*", osm_type: String = "*",
        include_dependencies: Boolean = false) => (result: OSMFilteredFeatures) with Effect(kind = "external") with Cost(tier = "expensive")

    /** Filters pre-extracted GeoJSON by OSM type stored in feature properties. */
    event facet FilterGeoJSONByOSMType(input_path: String, osm_type: String,
        tag_key: String = "", tag_value: String = "*") => (result: OSMFilteredFeatures) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Filters pre-extracted GeoJSON to features whose tag value starts with a
        prefix. Complements FilterByOSMTag (exact match): a prefix on the `ref`
        tag selects a route family, e.g. tag_key="ref", value_prefix="I " keeps
        Interstate freeways (I 5, I 80) and drops US/state routes (US 101, CA 1). */
    event facet FilterGeoJSONByTagPrefix(input_path: String, tag_key: String,
        value_prefix: String) => (result: OSMFilteredFeatures) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Filters pre-extracted GeoJSON to features whose `tag_key` value CONTAINS
        `substring` (case-insensitive unless `case_sensitive`). Completes the
        exact / prefix / contains / regex match family — e.g. tag_key="name",
        substring="Starbucks". */
    event facet FilterGeoJSONByTagContains(input_path: String, tag_key: String, substring: String, case_sensitive: Boolean = false) => (result: OSMFilteredFeatures) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Filters pre-extracted GeoJSON to features whose `tag_key` value matches the
        regular expression `pattern` (re.search — matches anywhere). For complex
        selections like tag_key="cuisine", pattern="pizza|italian". */
    event facet FilterGeoJSONByTagRegex(input_path: String, tag_key: String, pattern: String) => (result: OSMFilteredFeatures) with Effect(kind = "pure") with Cost(tier = "cheap")

    /** Filter a GeoJSON FeatureCollection by an arbitrary **Python script** —
     *  far more expressive than a single tag match. `script` is either a boolean
     *  expression over `feature` / `props` (its properties) / `geom`, e.g.
     *  `props.get("amenity")=="charging_station" and "tesla" in str(props.get("operator","")).lower()`,
     *  or a `def keep(feature): ...` returning truthy to keep. Runs sandboxed
     *  (safe builtins + re/math; no imports/IO). Writes the kept features to a
     *  derived `_filtered_<hash>` path. Implemented in the shared
     *  `_osm_tools.geojson_filter` library (the `filter-geojson` CLI shares it). */
    event facet ByScript(input_path: String, script: String) => (output_path: String, feature_count: Long, total: Long) with Effect(kind = "pure") with Cost(tier = "cheap")
}
