// Region-driven cache download.
//
// Universal cache facet that takes a fully-resolved Region and returns the
// downloaded OSMCache. Pairs with osm.Region.ResolveRegions for the
// recommended cross-region pattern:
//
//   resolved = ResolveRegions(names = ["Africa", "California", "Europe", "Quebec"])
//   andThen foreach r in resolved.regions {
//       cache = Download(region = $.r)
//       // ...analysis on cache...
//   }
//
// Eventually replaces the 50+ hardcoded per-region facets (California(),
// Quebec(), Algeria(), ...) which become thin one-line wrappers in step 4.
//
// Prerequisites: Compile with osmtypes.afl

/** Region-driven cache download. */
namespace osm.cache {
    use osm.types

    /** Download (or return the cached) Geofabrik PBF for a region.
     *  Idempotent: re-running with the same Region returns the existing
     *  cache entry with `wasInCache = true`.
     *
     *  Input is a fully-resolved Region (typically produced by
     *  `osm.Region.ResolveRegions`) — the handler reads
     *  `region.geofabrik_path` to fetch the extract.
     *
     *  `cache_policy` controls staleness handling:
     *   - "prefer_cache" (default): use a cached PBF AS-IS if present (no
     *     Geofabrik call) — so a present-but-out-of-date extract is used as is,
     *     never re-pulling gigabytes (Geofabrik rebuilds PBFs daily). This is the
     *     default so cache-backed runs (e.g. the MinIO object store) don't depend
     *     on internet egress or the AFL_OSM_USE_CACHE_IF_PRESENT env.
     *   - "auto": follow the AFL_OSM_USE_CACHE_IF_PRESENT env.
     *   - "refresh": always re-download fresh (used by the cache-update
     *     workflows in osmcache_refresh.ffl).
     *   - "revalidate": always check Geofabrik, re-download only if changed. */
    event facet Download(region: Region, cache_policy: String = "prefer_cache") => (cache: OSMCache) with Effect(kind = "external") with Cost(tier = "expensive")

    /** List the regions currently present in the local PBF cache (no network).
     *  The input side of a deliberate cache refresh — pair with `Download`
     *  under `cache_policy = "refresh"`. */
    event facet ListCachedRegions() => (regions: [Region]) with Effect(kind = "io") with Cost(tier = "cheap")
}
