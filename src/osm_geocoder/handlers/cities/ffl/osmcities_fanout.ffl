// Fan-out cities-by-zoom — per-subregion parallel extraction.
//
// Demonstrates the foreach-fan-out alternative to the monolithic
// osm.Cities.workflows.CitiesByZoomTiledMap: instead of one ~19 GB
// continental PBF scanned by a single runner (~50+ min), resolve North
// America into its 64 subregions (US states + Canadian provinces + Mexico
// + Greenland) and extract populated places from each in PARALLEL across
// the runner fleet, then merge -> tier -> tile -> render exactly as before.
//
// Wall-clock for the (CPU-bound) extraction collapses to ~slowest-single-
// subregion when the osm task-list has several runners; with a single
// runner the foreach iterations serialise and the monolithic continental
// scan is the better choice. Decision rule:
//   >= several osm runners  -> fan out per subregion (this workflow)
//   1 osm runner            -> osm.Cities.workflows.CitiesByZoomTiledMap

namespace osm.Cities.fanout {
    use osm.types
    use osm.Region
    use osm.cache
    use osm.Population
    use osm.Cities
    use osm.Transform
    use osm.Tiles
    use osm.viz

    /** Resolve `region_names` and, in parallel (andThen foreach), download
     *  each subregion's PBF and extract its populated places. The per-iter
     *  output path is wrapped in a 1-element list so the runtime's
     *  list-typed yield-merge aggregates all paths into `place_paths`. */
    facet ExtractPlacesAcrossSubregions(
        region_names: [String],
        min_population: Long = 10000
    ) => (place_paths: [String]) andThen {
        resolved = osm.Region.ResolveRegions(names = $.region_names, expand = "subregions")
    } andThen foreach r in resolved.regions {
        cache = osm.cache.Download(region = $.r)
        places = osm.Population.AllPopulatedPlaces(
            cache = cache.cache,
            min_population = $.min_population
        )
        yield ExtractPlacesAcrossSubregions(place_paths = [places.result.output_path])
    }

    /** North America cities-by-zoom, parallel per-subregion extraction.
     *  Same four population bands and zoom tiers as
     *  osm.Cities.workflows.CitiesByZoomTiledMap; only the extraction stage
     *  differs (fan-out instead of one continental scan). */
    workflow CitiesByZoomTiledMapFanout(
        // A single parent name expands to its finest Geofabrik leaf extracts
        // (ResolveRegions(expand = "subregions") in the facet above): one
        // "north-america" → all US states + Canadian provinces + Mexico +
        // Greenland. Pass an explicit list to target specific subregions —
        // leaf names pass through expansion unchanged.
        region_names: [String] = ["north-america"],
        zoom_a: Long = 3,  min_pop_a: Long = 5000000,
        zoom_b: Long = 6,  min_pop_b: Long = 1000000,
        zoom_c: Long = 8,  min_pop_c: Long = 500000,
        zoom_d: Long = 10, min_pop_d: Long = 10000,
        tiles_max_zoom: Long = 14,
        center_lon: Double = -100.0,
        center_lat: Double = 45.0,
        view_zoom: Double = 3.0,
        title: String = "North America cities by zoom (fan-out)"
    ) => (
        map_path: String,
        total_count: Long,
        tier_a_count: Long,
        tier_b_count: Long,
        tier_c_count: Long,
        tier_d_count: Long
    ) andThen {
        ext = ExtractPlacesAcrossSubregions(
            region_names = $.region_names,
            min_population = $.min_pop_d
        )
        merged = osm.Transform.MergeLayers(inputs = ext.place_paths)
        tiered = osm.Cities.TierCitiesByPopulation(
            input_path = merged.result.output_path,
            zoom_a = $.zoom_a, min_pop_a = $.min_pop_a,
            zoom_b = $.zoom_b, min_pop_b = $.min_pop_b,
            zoom_c = $.zoom_c, min_pop_c = $.min_pop_c,
            zoom_d = $.zoom_d, min_pop_d = $.min_pop_d
        )
        split = osm.Cities.SplitTiers(
            input_path = tiered.result.output_path,
            zoom_a = $.zoom_a, zoom_b = $.zoom_b, zoom_c = $.zoom_c, zoom_d = $.zoom_d
        )
        tiles_a = osm.Tiles.BuildVectorTiles(
            geojson_path = split.result.tier_a_path, layer_name = "cities_5M",
            min_zoom = 0, max_zoom = $.tiles_max_zoom
        )
        tiles_b = osm.Tiles.BuildVectorTiles(
            geojson_path = split.result.tier_b_path, layer_name = "cities_1M",
            min_zoom = 4, max_zoom = $.tiles_max_zoom
        )
        tiles_c = osm.Tiles.BuildVectorTiles(
            geojson_path = split.result.tier_c_path, layer_name = "cities_500K",
            min_zoom = 7, max_zoom = $.tiles_max_zoom
        )
        tiles_d = osm.Tiles.BuildVectorTiles(
            geojson_path = split.result.tier_d_path, layer_name = "cities_10K",
            min_zoom = 9, max_zoom = $.tiles_max_zoom
        )
        map = osm.viz.RenderTiledMap(
            tiles = [
                tiles_a.result.output_path, tiles_b.result.output_path,
                tiles_c.result.output_path, tiles_d.result.output_path
            ],
            layer_names = ["cities_5M", "cities_1M", "cities_500K", "cities_10K"],
            colors = ["#d62728", "#d62728", "#d62728", "#d62728"],
            title = $.title,
            center_lon = $.center_lon, center_lat = $.center_lat, zoom = $.view_zoom
        )
        yield CitiesByZoomTiledMapFanout(
            map_path = map.result.output_path,
            total_count = tiered.result.total_count,
            tier_a_count = split.result.tier_a_count,
            tier_b_count = split.result.tier_b_count,
            tier_c_count = split.result.tier_c_count,
            tier_d_count = split.result.tier_d_count
        )
    }
}
