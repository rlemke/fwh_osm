// Worked composition over osm.Network — the "routes between all large cities"
// capstone from docs/architecture/approximate-freeway-routing.md.
//
// This is the exact decomposition from the original design question ("routes
// between all US cities over 1M population"), composed from orthogonal
// primitives rather than hand-coded:
//
//     CacheRegion(region)
//       -> ExtractCategory(population) -> FilterByPopulation(min) [the cities = waypoints]
//       -> ExtractCategory(roads) -> FilterByOSMType(motorway)
//          -> BuildNetwork(ref_filter="I ")                       [the interstate graph]
//       -> RouteMatrix(network, cities)                           [all-pairs routes]
//
// RouteMatrix accepts the cities GeoJSON path directly (the GeoJSON->waypoints
// adapter is built into _parse_points), so the merged-cities layer feeds the
// matrix with no glue. One region per leaf; fan out across states with
// `andThen foreach` at the workflow for the national run.

/** All-pairs interstate routes between the large cities of a region. */
namespace osm.Network.workflows {
    use osm.types
    use osm.Region
    use osm.cache

    /** Computes the all-pairs approximate interstate-route matrix between every
        place in `region` with population >= `min_population`. Defaults to
        California cities over 1,000,000 (Los Angeles, San Diego, San Jose).
        `place_type` narrows the population layer (city/town/all). */
    workflow CityRoutesByPopulation(region: String = "California", min_population: Long = 1000000,
        place_type: String = "city", snap_tolerance_m: Double = 25.0) => (matrix_path: String, pair_count: Long, reachable_count: Long, city_count: Long) andThen {
            cache = osm.ops.CacheRegion(region = $.region)
            body = CityRoutesFromCache(
                cache = cache.cache,
                min_population = $.min_population,
                place_type = $.place_type,
                snap_tolerance_m = $.snap_tolerance_m
            )
            yield CityRoutesByPopulation(
                matrix_path = body.matrix_path,
                pair_count = body.pair_count,
                reachable_count = body.reachable_count,
                city_count = body.city_count
            )
        }

    /** Cache-dependent body for CityRoutesByPopulation (one region per leaf; fan
        out across regions with `andThen foreach` at the workflow when needed). */
    facet CityRoutesFromCache(cache: OSMCache, min_population: Long = 1000000,
        place_type: String = "city", snap_tolerance_m: Double = 25.0) => (matrix_path: String, pair_count: Long, reachable_count: Long, city_count: Long) andThen {
            // Waypoints: places at or above the population threshold.
            places = osm.Source.PBF.ExtractCategory(cache = $.cache, category = "population")
            cities = osm.Population.FilterByPopulation(
                input_path = places.output_path,
                min_population = $.min_population,
                place_type = $.place_type,
                operator = "gte"
            )
            // Network: the interstate freeway graph (motorways tagged ref "I ").
            roads = osm.Source.PBF.ExtractCategory(cache = $.cache, category = "roads")
            motorways = osm.Filters.FilterGeoJSONByOSMType(
                input_path = roads.output_path,
                osm_type = "*",
                tag_key = "highway",
                tag_value = "motorway"
            )
            net = osm.Network.BuildNetwork(
                edges_path = motorways.result.output_path,
                snap_tolerance_m = $.snap_tolerance_m,
                ref_filter = "I "
            )
            // All-pairs approximate routes — the cities GeoJSON feeds straight in.
            matrix = osm.Network.RouteMatrix(
                network_path = net.result.network_path,
                points = cities.result.output_path
            )
            yield CityRoutesFromCache(
                matrix_path = matrix.result.result_path,
                pair_count = matrix.result.pair_count,
                reachable_count = matrix.result.reachable_count,
                city_count = cities.result.feature_count
            )
        }

    /** Fan-out approximate routing over a PREBUILT network — the distributable
        unit. One ApproxRoute task per (from,to) pair; the N pure tasks are
        claimed lock-free across the runner fleet, each runner loading the shared
        network once (read-once-per-runner). This is the workflow used for the
        multi-server proof: `andThen foreach` over `pairs` fans out, runners on
        different hosts/containers share the one network artifact. `pairs` is a
        JSON list of {from_lat, from_lon, to_lat, to_lon}. */
    workflow RouteFanout(network_path: String, pairs: Json) => (routes: [String], distances: [Double]) andThen foreach p in $.pairs {
        r = osm.Network.ApproxRoute(
            network_path = $.network_path,
            from_lat = $.p.from_lat, from_lon = $.p.from_lon,
            to_lat = $.p.to_lat, to_lon = $.p.to_lon
        )
        yield RouteFanout(routes = [r.result.route_path], distances = [r.result.distance_km])
    }

    // --- National (multi-region) pipeline: fan-out collect, then linear render ---
    // FFL has no post-foreach aggregation block, so this is the genomics
    // fan-out / fan-in split: CollectUSRouteLayers fans out per region (Download
    // auto-caches/downloads each state's PBF), then RenderUSCityRoutesMap is a
    // linear merge -> build -> route -> render over the collected layers.

    /** Fan-out: for every region in `region_names`, download (auto-cache) its PBF
        and extract the interstate-motorway layer + the cities >= `min_population`.
        Returns the per-region layer paths as two aggregated lists (one element
        per region), ready for RenderUSCityRoutesMap. `osm.cache.Download` fetches
        any region not already cached. */
    workflow CollectUSRouteLayers(region_names: [String], min_population: Long = 1000000,
        place_type: String = "city") => (interstate_layers: [String], city_layers: [String]) andThen foreach name in $.region_names {
            reg = osm.Region.ResolveRegion(name = $.name)
            cache = osm.cache.Download(region = reg.region)
            // Motorway-only extract (road_class targets highway=motorway) — far
            // cheaper than extracting all roads then filtering; BuildNetwork's
            // ref_filter="I " narrows to interstates downstream.
            motorways = osm.Source.PBF.ExtractRoads(cache = cache.cache, road_class = "motorway")
            places = osm.Source.PBF.ExtractCategory(cache = cache.cache, category = "population")
            cities = osm.Population.FilterByPopulation(
                input_path = places.output_path, min_population = $.min_population,
                place_type = $.place_type, operator = "gte"
            )
            yield CollectUSRouteLayers(
                interstate_layers = [motorways.result.output_path],
                city_layers = [cities.result.output_path]
            )
        }

    /** Fan-in: merge the per-region interstate layers into one network, merge the
        per-region city layers, route all city pairs over the network, and render
        the routes + cities to an HTML map. Feed it the two lists from
        CollectUSRouteLayers. */
    workflow RenderUSCityRoutesMap(interstate_layers: [String], city_layers: [String],
        snap_tolerance_m: Double = 25.0,
        title: String = "US interstate routes between cities over 1M") => (map_path: String, route_count: Long, city_count: Long, network_edges: Long) andThen {
            all_interstates = osm.Transform.MergeLayers(inputs = $.interstate_layers)
            net = osm.Network.BuildNetwork(
                edges_path = all_interstates.result.output_path,
                snap_tolerance_m = $.snap_tolerance_m, ref_filter = "I "
            )
            all_cities = osm.Transform.MergeLayers(inputs = $.city_layers)
            routes = osm.Network.RouteLayer(
                network_path = net.result.network_path,
                points = all_cities.result.output_path
            )
            map = osm.viz.RenderLayers(
                layers = [routes.result.output_path, all_cities.result.output_path],
                colors = ["#1f78b4", "#e31a1c"],
                title = $.title
            )
            yield RenderUSCityRoutesMap(
                map_path = map.result.output_path,
                route_count = routes.result.route_count,
                city_count = all_cities.result.feature_count,
                network_edges = net.result.edge_count
            )
        }
}
