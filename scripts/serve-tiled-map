#!/usr/bin/env python3
"""serve-tiled-map — minimal HTTP server with Range support for PMTiles viewers.

``python -m http.server`` does NOT honor HTTP Range requests, which silently
breaks any PMTiles viewer (the browser will either download the whole archive
or, more commonly, the PMTiles JS will give up and the map stays blank). This
serves the current directory (or one passed as the second argument) on the
given port (default 8765) with proper 206 Partial Content responses for
``Range: bytes=...`` GETs.

Usage:
    scripts/serve-tiled-map                 # serve cwd on :8765
    scripts/serve-tiled-map 8765 path/to/map_dir
"""
import os, re, sys
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer


class RangeHandler(SimpleHTTPRequestHandler):
    def end_headers(self):
        self.send_header("Accept-Ranges", "bytes")
        super().end_headers()

    def do_GET(self):
        rng = self.headers.get("Range")
        if not rng:
            return super().do_GET()
        path = self.translate_path(self.path)
        if not os.path.isfile(path):
            self.send_error(404); return
        m = re.match(r"bytes=(\d+)-(\d*)\s*$", rng.strip())
        if not m:
            return super().do_GET()
        size = os.path.getsize(path)
        start = int(m.group(1))
        end = int(m.group(2)) if m.group(2) else size - 1
        if start >= size:
            self.send_response(416); self.send_header("Content-Range", f"bytes */{size}"); self.end_headers(); return
        end = min(end, size - 1); length = end - start + 1
        self.send_response(206)
        self.send_header("Content-Type", self.guess_type(path))
        self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.send_header("Content-Length", str(length))
        super().end_headers()
        with open(path, "rb") as f:
            f.seek(start); remaining = length
            while remaining > 0:
                buf = f.read(min(65536, remaining))
                if not buf: break
                self.wfile.write(buf); remaining -= len(buf)


if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8765
    if len(sys.argv) > 2:
        os.chdir(sys.argv[2])
    print(f"serve-tiled-map listening on http://localhost:{port}/  (cwd={os.getcwd()})", flush=True)
    try:
        ThreadingHTTPServer(("", port), RangeHandler).serve_forever()
    except KeyboardInterrupt:
        print("stopped")
