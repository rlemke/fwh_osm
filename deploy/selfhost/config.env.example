# Self-hosted OSM extract server + nightly maintain — configuration.
# Copy to  ~/.facetwork/osm-selfhost/config.env  (install.sh seeds it for you) and edit.

# Where the fwh_osm checkout lives (provides the planet-maintain tool).
REPO="$HOME/fw_handlers/fwh_osm"

# Python interpreter for the maintain job — MUST have pyosmium importable. On
# server3 that is facetwork's venv (pyosmium + osm_geocoder are installed there);
# adjust per host. The static server needs nothing special (stdlib http.server).
PYTHON="$HOME/facetwork/.venv/bin/python"

# State home for this service.
HOMEDIR="$HOME/.facetwork/osm-selfhost"

# The master planet kept current in place. Until you bootstrap the REAL planet
# (see README), this can be any PBF with a replication header (e.g. a small
# country extract) so the pipeline is exercised end-to-end.
MASTER="$HOMEDIR/master.osm.pbf"

# Region spec consumed by planet_bootstrap/maintain: [{key, bbox|poly}, ...].
REGIONS="$HOMEDIR/regions.json"

# The served output tree (planet-maintain --out). The static server roots here.
WWW="$HOMEDIR/www"

# Static server bind port. Extracts are then at  http://<host>:PORT/<region>-latest.osm.pbf
PORT=8088

# Base URL stamped into extract replication headers AND the value consumers set as
# FW_GEOFABRIK_BASE_URL. Must be how consumers actually reach this server. For the
# fleet (docker runners) prefer the infra IP or an afl-* alias they can resolve,
# the same way afl-minio is mapped — server3.local may not resolve inside containers.
BASE_URL="http://server3.local:8088"

# osmium extract strategy (smart = reference-complete).
STRATEGY=smart

# Nightly maintain schedule (local time).
MAINTAIN_HOUR=3
MAINTAIN_MINUTE=30
