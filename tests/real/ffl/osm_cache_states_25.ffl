/** Downloads OSM PBF caches for 25 US states in parallel. */
namespace osm.UnitedStates.cache {
  use osm.types
  use osm.ops
  use osm.cache.UnitedStates

  /** Fetches and aggregates OSM cache data for 25 US states. */
  workflow DownloadStates_25() => (cache: [OSMCache]) andThen {
    alabama = osm.cache.UnitedStates.Alabama()
    alaska = osm.cache.UnitedStates.Alaska()
    arizona = osm.cache.UnitedStates.Arizona()
    arkansas = osm.cache.UnitedStates.Arkansas()
    california = osm.cache.UnitedStates.California()
    colorado = osm.cache.UnitedStates.Colorado()
    connecticut = osm.cache.UnitedStates.Connecticut()
    delaware = osm.cache.UnitedStates.Delaware()
    districtOfColumbia = osm.cache.UnitedStates.DistrictOfColumbia()
    florida = osm.cache.UnitedStates.Florida()
    georgia = osm.cache.UnitedStates.Georgia()
    hawaii = osm.cache.UnitedStates.Hawaii()
    idaho = osm.cache.UnitedStates.Idaho()
    illinois = osm.cache.UnitedStates.Illinois()
    indiana = osm.cache.UnitedStates.Indiana()
    iowa = osm.cache.UnitedStates.Iowa()
    kansas = osm.cache.UnitedStates.Kansas()
    kentucky = osm.cache.UnitedStates.Kentucky()
    louisiana = osm.cache.UnitedStates.Louisiana()
    maine = osm.cache.UnitedStates.Maine()
    maryland = osm.cache.UnitedStates.Maryland()
    massachusetts = osm.cache.UnitedStates.Massachusetts()
    michigan = osm.cache.UnitedStates.Michigan()
    minnesota = osm.cache.UnitedStates.Minnesota()
    mississippi = osm.cache.UnitedStates.Mississippi()
    yield DownloadStates_25(cache = alabama.cache ++ alaska.cache ++ arizona.cache ++ arkansas.cache ++ california.cache ++ colorado.cache ++ connecticut.cache ++ delaware.cache ++ districtOfColumbia.cache ++ florida.cache ++ georgia.cache ++ hawaii.cache ++ idaho.cache ++ illinois.cache ++ indiana.cache ++ iowa.cache ++ kansas.cache ++ kentucky.cache ++ louisiana.cache ++ maine.cache ++ maryland.cache ++ massachusetts.cache ++ michigan.cache ++ minnesota.cache ++ mississippi.cache)
  }

}
